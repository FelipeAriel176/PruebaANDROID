<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    tools:context=".MenuActivity">

    <TextView
        android:id="@+id/tvBienvenidaSandbox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="TextView" />

    <RadioGroup
        android:id="@+id/grupoOpciones"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp">

        <RadioButton
            android:id="@+id/radioOpcion1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Estudiante1" />

        <RadioButton
            android:id="@+id/radioOpcion2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Estudiante2" />
    </RadioGroup>

    <Switch
        android:id="@+id/switchIDD"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Switch" />

    <CheckBox
        android:id="@+id/checkBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/confirmarVal" />

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TextToSpeech"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="20dp"/>

    <EditText
        android:id="@+id/inputVoz"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Escribe algo para que el teléfono lo diga"
        android:layout_marginHorizontal="16dp"/>

    <Button
        android:id="@+id/btnHablar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:text="@string/talkts" />

    <RatingBar
        android:id="@+id/ratingBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <Button
        android:id="@+id/button3"
        android:layout_width="match_parent"
        android:layout_height="57dp"
        android:text="@string/validarr" />

    <EditText
        android:id="@+id/editTextTextPostalAddress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ems="10"
        android:inputType="textPostalAddress" />

    <EditText
        android:id="@+id/editTextDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ems="10"
        android:inputType="date" />

    <EditText
        android:id="@+id/editTextTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ems="10"
        android:inputType="time" />

    <com.google.android.material.chip.Chip
        android:id="@+id/chip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:text="@string/chip" />

    <WebView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</LinearLayout>